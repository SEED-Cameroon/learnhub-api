PORT=5000
MONGO_URI=your-atlas-connection-string
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLOUDINARY_URL=your-cloudinary-url


 http://localhost:5000/api/courses/YOUR_COURSE_ID/comments
 POST http://localhost:5000/api/subscriptions
GET  http://localhost:5000/api/subscriptions/me

GET  /api/courses/:id/comments   -- public
POST /api/courses/:id/comments   -- authenticated

GET /api/tutors
GET /api/tutors?subject=Mathematics

PATCH /api/tutors/:id
listTutors()       → GET /api/tutors
getTutor()         → GET /api/tutors/:id
updateTutor()      → PATCH /api/tutors/:id